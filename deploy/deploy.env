# G3 Proxy deploy configuration (required – script does not prompt)
# Edit auth + ICAP settings then run ./deploy.sh

# Proxy authentication mode:
# - users_file (recommended): copy USERS_FILE (hashed tokens) into container
# - single_user: generate users.yaml from PROXY_USER/PROXY_PASS (plaintext only lives in deploy.env)
AUTH_MODE=users_file

# If AUTH_MODE=users_file, this file is copied into deploy/config/users.yaml.
# Path can be absolute, or relative to the deploy/ directory.
USERS_FILE=config/users.yaml

# If AUTH_MODE=single_user (fallback)
# PROXY_USER=rohan
# PROXY_PASS=rohan900

# ICAP server (optional; use host.docker.internal when ICAP runs on host, same machine as Docker)
ICAP_IP=host.docker.internal
ICAP_PORT=1344
