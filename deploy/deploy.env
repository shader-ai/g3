# G3 gateway deploy configuration — edit then run ./deploy.sh

# ── ICAP server ──────────────────────────────────────────────────────────────
# Use host.docker.internal when icapeg runs on the host (Docker bridge mode).
ICAP_IP=host.docker.internal
ICAP_PORT=1344

# ── Urai broker ──────────────────────────────────────────────────────────────
# Peer-sync polls GET /tunnel/peers with URAI_GATEWAY_TOKEN.
# Set URAI_BROKER_URL to the EC2 backend host and URAI_GATEWAY_TOKEN to the
# value from backend/.env (they must match).
URAI_BROKER_URL=https://FILL_WITH_BACKEND_HOST/api/v1
URAI_GATEWAY_TOKEN=1baa7ffc24fb638b43006e9f3e5330592af804cf55ae2a19dccf8f59d771b276

# ── WireGuard ─────────────────────────────────────────────────────────────────
# UDP port exposed to the internet for agent connections.
WG_PORT=51820

# Peer-sync poll interval (seconds). Default 5.
PEER_SYNC_INTERVAL=5
